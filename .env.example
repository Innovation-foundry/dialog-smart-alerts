VITE_USE_MOCK=true
VITE_ENV=dev
VITE_API_BASE=/api

# MQTT Configuration — the modem-gateway hardware publishes to the HiveMQ public broker.
# NOTE: nothing in the backend loads this .env file (no python-dotenv). These vars must
# be set in the real environment — e.g. the Railway project's Variables tab.
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# Producer auth. false = grace period: a detection for a registered device is accepted even with a
# wrong/missing api_key (only logged). Set true once every gateway sends its key — then detections
# AND status messages without a valid key are dropped.
MQTT_ENFORCE_AUTH=false
# Topics the backend SUBSCRIBES to (must match what the gateway publishes):
MQTT_TOPIC=devices/modem-gateway/alerts
MQTT_IMAGE_TOPIC=devices/modem-gateway/alerts/image
MQTT_STATUS_TOPIC=devices/modem-gateway/status
# Actuator command topics the backend PUBLISHES to are fixed:
#   dialog/actuators/signs/{station_id}/command
#   dialog/actuators/sirens/{station_id}/command

# SMS (Ideabiz) — read by backend/notifier.py. Real SMS is only sent when SMS_ENABLED=true.
# IDEABIZ_TOKEN has no default in code: with SMS on and no token, sends are recorded as failed.
SMS_ENABLED=false
IDEABIZ_TOKEN=
IDEABIZ_API_URL=https://ideabiz.lk/apicall/smsmessaging/v3/outbound/87798/requests
IDEABIZ_SENDER_PORT=tel:87798
IDEABIZ_SENDER_NAME=smartalerts

# Admin login (backend/auth.py). Gates every admin API route (CRUD, simulator, etc.) behind a
# session cookie — no defaults in code, so without both vars set the admin API is unreachable
# (every login attempt fails). Device ingestion (POST /api/events) and the few public field-display
# endpoints (kiosk/sign status, SSE stream, health) are unaffected.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# GIS instance (services/gis) — read by backend/gis_client.py. See services/gis/docs/integration.md.
# The GIS service has no login of its own: keep it on the internal network (Railway: no public domain).
GIS_ENABLED=true
GIS_API_URL=http://localhost:8100
GIS_TENANT_ID=dialog-smart-alerts
GIS_ENRICH_TIMEOUT_S=2
